---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Card from '../components/Card.astro';
import SectionHead from '../components/SectionHead.astro';
import Ad from '../components/Ad.astro';
import { getPosts, type Author } from '../lib/content';
import { site, publisher } from '../site';
import { langFromPath, authorHref, pageHref } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props { author: Author }
const { author } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const posts = (await getPosts(Astro.locals, lang)).filter((p) => p.author.id === author.id);
const a = author.data;
/* Les jeux que cette personne couvre, dédoublonnés et dans l'ordre du site. */
const knowsAbout = [...new Set(posts.map((p) => p.game?.data.title).filter(Boolean))] as string[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: a.name,
  jobTitle: a.role,
  description: a.bio,
  url: new URL(authorHref(lang, author.id), site.url).href,
  worksFor: publisher,
  /* L'EXPERTISE, dite plutôt que sous-entendue.
     Un moteur qui choisit qui citer sur GTA 6 cherche qui en parle
     habituellement. La réponse était dans la base — les jeux que cette personne
     a effectivement couverts — et n'était déclarée nulle part.
     `creds` reste hors du balisage : « Spécialité : action-RPG » et « vérifie
     ses guides à chaque patch » sont un domaine et une méthode, pas des
     diplômes, et les déclarer en `hasCredential` serait une affirmation que
     rien ne soutient. `knowsAbout` dit la même chose et se vérifie en cliquant.
     Pas de `memberOf` non plus : `worksFor` porte déjà ce lien-là. */
  ...(knowsAbout.length ? { knowsAbout } : {}),
};
---
<Base title={a.name} description={a.bio} jsonLd={jsonLd} alt={(l) => authorHref(l, author.id)}>
  <div class="page" style="padding-top:40px">
    <Crumbs trail={[{ label: t('foot.team'), href: pageHref(lang, 'about') }, { label: a.name }]} />
    <h1 class="d2" style="margin:12px 0 24px">{a.name}</h1>
    <AuthorBox author={author} count={posts.length} />

    <section class="sec">
      <SectionHead title={t('author.articles')} sub={t('author.publications')(posts.length)} />
      <div class="pgrid">
        {posts.map((p) => <Card post={p} variant="sm" />)}
      </div>
    </section>

    <div style="margin-block:var(--s-7)"><Ad h="90" unit={import.meta.env.PUBLIC_AD_LEADERBOARD} /></div>
  </div>
</Base>

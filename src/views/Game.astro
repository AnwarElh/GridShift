---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Fig from '../components/Fig.astro';
import Kicker from '../components/Kicker.astro';
import Platforms from '../components/Platforms.astro';
import Score from '../components/Score.astro';
import Consensus from '../components/Consensus.astro';
import Feed from '../components/Feed.astro';
import Card from '../components/Card.astro';
import SectionHead from '../components/SectionHead.astro';
import Ad from '../components/Ad.astro';
import Offers from '../components/Offers.astro';
import GameCard from '../components/GameCard.astro';
import { getPosts, getGames, byGame, type Game } from '../lib/content';
import { int } from '../lib/format';
import { site } from '../site';
import {
  langFromPath, otherLocale, pageHref, gameHref, homeHref, type SectionKey,
} from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props { game: Game }
const { game } = Astro.props;
const d = game.data;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);

const all = await getPosts(Astro.locals, lang);
const posts = byGame(all, game.id);
/* La meilleure offre remonte en tête de fiche : c'est l'action que la page
   sert. Le tableau complet reste dans la colonne, avec sa mention. */
const best = d.offers.find((o) => o.tone === 'brass') ?? d.offers[0];

/* Une fiche peu couverte laissait une colonne vide face à un pavé de 600 px.
   On finit par où le lecteur va ensuite : les autres jeux suivis, le même
   genre d'abord. */
const allGames = await getGames(Astro.locals, lang);
const sameGenre = (g: typeof game) => g.data.genre === d.genre;
const otherGames = [
  ...allGames.filter((g) => g.id !== game.id && sameGenre(g)),
  ...allGames.filter((g) => g.id !== game.id && !sameGenre(g)),
].slice(0, 4);

const scored = all.filter((p) => p.data.score !== undefined);
const average = scored.length ? scored.reduce((s, p) => s + p.data.score!, 0) / scored.length : 7.4;
const better = scored.filter((p) => (p.data.score ?? 0) > (d.score ?? 0)).length;
const percentile = scored.length ? Math.max(1, Math.round((better / scored.length) * 100)) : 50;

const n = (k: SectionKey) => posts.filter((p) => p.data.type === k).length;
const tabs = [
  { key: 'overview', label: t('game.overview'), n: undefined as number | undefined },
  { key: 'review', label: t('nav.reviews'), n: n('review') },
  { key: 'guide', label: t('nav.guides'), n: n('guide') },
  { key: 'news', label: t('nav.news'), n: n('news') },
  { key: 'setup', label: t('nav.setup'), n: n('setup') },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: d.title,
  publisher: d.studio,
  genre: d.genre,
  inLanguage: lang,
  gamePlatform: d.platforms.map((p) => p.name),
  url: new URL(gameHref(lang, game.id), site.url).href,
  ...(d.score !== undefined
    ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: d.score, bestRating: 10, ratingCount: Math.max(1, posts.length) } }
    : {}),
};
---
<Base title={d.title} description={t('game.desc')(d.title, d.studio)} jsonLd={jsonLd}
      alt={gameHref(otherLocale(lang), game.id)}>
  <div class="hub">
    <div class="hub-bg">{d.hero ? <Fig src={d.hero} ratio="21-9" /> : <span class="ph"></span>}</div>
    <div class="hub-in">
      <Fig src={d.cover} alt={d.title} ratio="3-4" class="hub-cover" />
      <div class="hub-id">
        <Crumbs trail={[{ label: t('nav.games'), href: pageHref(lang, 'games') }, { label: d.title }]} style="margin-bottom:12px" />
        <h1>{d.title}</h1>
        <p class="studio">{d.studio} · {d.genre} · {d.released}</p>
        <Platforms platforms={d.platforms} style="margin-bottom:14px" />
        <div class="hub-facts">
          {d.facts.map((f) => <span><b>{f.label}</b> {f.value}</span>)}
          {d.version && <span><b>{t('game.trackedVersion')}</b> {d.version}</span>}
        </div>
      </div>
      <div class="hub-actions">
        {d.score !== undefined && (
          <span class="plate p-lg"><span class="plate-in" style="text-align:center;padding:16px 24px">
            <Kicker plain tone="mute" style="display:block;margin-bottom:6px">{t('game.ourScore')}</Kicker>
            <Score score={d.score} class="sc-center" />
            <Consensus score={d.score} average={Number(average.toFixed(1))} percentile={percentile} />
          </span></span>
        )}
        {best ? (
          <a class="btn btn-primary btn-lg btn-block" href={best.url} rel="sponsored nofollow noopener" target="_blank">
            {t('game.bestPrice')(best.price)}
          </a>
        ) : (
          <a class="btn btn-primary btn-block" href={`${homeHref(lang)}#newsletter`}>{t('game.follow')}</a>
        )}
        {best && <span class="meta" style="text-align:center">{t('game.atShop')(best.shop)} · <a href="#offers">{t('game.allOffers')}</a></span>}
        {d.followers && <span class="meta" style="text-align:center">{t('game.followers')(int(d.followers, lang))}</span>}
      </div>
    </div>
    <div class="page">
      <div class="tabs" role="tablist">
        {tabs.map((tab, i) => (
          <button
            class="tab" role="tab" id={`tab-${tab.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.key}`}
            tabindex={i === 0 ? 0 : -1}
            data-panel={tab.key}>
            {tab.label}{tab.n !== undefined && <span class="n">{tab.n}</span>}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="page split" style="padding-top:40px">
    <div>
      <div data-tabpanel="overview" id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" tabindex="0">
        <div class="read" style="margin-bottom:40px"><p>{d.summary}</p></div>
        <SectionHead title={t('game.allCoverage')} sub={t('game.coverageSub')} />
        <Feed posts={posts} side="version" />
      </div>
      {tabs.slice(1).map((tab) => (
        <div data-tabpanel={tab.key} id={`panel-${tab.key}`} role="tabpanel" aria-labelledby={`tab-${tab.key}`} tabindex="0" hidden>
          <SectionHead title={tab.label} sub={t('game.articlesOn')(tab.n ?? 0, d.title)} />
          {tab.n ? (
            <div class="pgrid" style="margin-top:24px">
              {posts.filter((p) => p.data.type === tab.key).map((p) => <Card post={p} variant="sm" showVersion />)}
            </div>
          ) : (
            <div class="empty"><span class="glyph" aria-hidden="true">∅</span><h3>{t('archive.nothingYet')}</h3>
              <p>{t('game.noneOfType')(tab.label)}</p></div>
          )}
        </div>
      ))}

      {otherGames.length > 0 && (
        <section class="sec">
          <SectionHead title={t('game.alsoFollow')} sub={t('game.alsoFollowSub')}>
            <a class="btn btn-sm btn-quiet" href={pageHref(lang, 'games')}>{t('game.wholeDatabase')}</a>
          </SectionHead>
          <div class="grid-2">
            {otherGames.map((g) => <GameCard game={g} count={byGame(all, g.id).length} />)}
          </div>
        </section>
      )}
    </div>

    <aside class="sticky">
      <Offers game={game} id="offers" />

      {d.userScore !== undefined && (
        <div class="card-framed">
          <Kicker plain tone="mute">{t('game.playerScore')}</Kicker>
          <div style="display:flex;align-items:baseline;gap:12px;margin-top:10px">
            <Score score={d.userScore} size="sm" />
            {d.userVotes && <span class="meta">{t('game.votes')(int(d.userVotes, lang))}</span>}
          </div>
          {d.completion !== undefined && (
            <div class="rarity" style="margin-top:12px">
              <span>{t('game.completedBy')}</span><span class="bar"><i style={`width:${d.completion}%`}></i></span><span>{d.completion} %</span>
            </div>
          )}
        </div>
      )}

      <Ad h={posts.length > 2 ? '600' : '250'} unit={import.meta.env.PUBLIC_AD_SIDEBAR} />
    </aside>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { credits } from '../lib/credits';
import { langFromPath, otherLocale, pageHref } from '../i18n/config';

/* Toutes les images du site sont réutilisables : CC0, domaine public, CC BY
   ou CC BY-SA, depuis Wikimedia Commons. Les licences BY et BY-SA imposent
   de nommer l'auteur et la licence — cette page le fait pour l'ensemble. */
const lang = langFromPath(Astro.url.pathname);
const rows = Object.entries(credits).sort(([a], [b]) => a.localeCompare(b));
const copy = {
  en: {
    title: 'Photo credits',
    desc: 'Author, licence and source of every image used on Gridshift.',
    lede: 'Game artwork on this site is the publishers’ own promotional material — store cover art and listing screenshots. It stays the property of its rights holders and is reproduced here as editorial illustration: you cannot report on a game without showing it. We claim no rights over these images. Every one is listed below with its publisher and the page it came from. Any publisher who wants an image removed or replaced can write to us and it will be done.',
  },
  fr: {
    title: 'Crédits photo',
    desc: 'Auteur, licence et source de chaque image utilisée sur Gridshift.',
    lede: 'Les visuels de jeu de ce site sont les supports promotionnels des éditeurs eux-mêmes — jaquettes de boutique et captures de fiche. Ils restent la propriété de leurs ayants droit et sont repris ici au titre de l’illustration éditoriale : on ne peut pas rendre compte d’un jeu sans le montrer. Nous ne revendiquons aucun droit sur ces images. Chacune est listée ci-dessous avec son éditeur et la page dont elle provient. Tout éditeur qui souhaite qu’un visuel soit retiré ou remplacé peut nous écrire ; ce sera fait.',
  },
}[lang];
---
<Base title={copy.title} description={copy.desc} alt={pageHref(otherLocale(lang), 'credits')}>
  <div class="page" style="padding-top:40px;padding-bottom:var(--s-9)">
    <Crumbs trail={[{ label: copy.title }]} />
    <h1 class="d2" style="margin:12px 0 8px">{copy.title}</h1>
    <p style="color:var(--tx-2);max-width:62ch;line-height:1.6">{copy.lede}</p>

    <div class="cal" style="margin-top:32px">
      {rows.map(([key, c]) => (
        <div class="cal-row credit-row">
          <span class="date" style="width:auto">{key}</span>
          <span>
            <b style="display:block">{c.artist}</b>
            <a class="meta" href={c.source} rel="noopener nofollow" target="_blank">{c.file}</a>
          </span>
          <span class="meta" style="white-space:nowrap">
            {c.licenceUrl
              ? <a href={c.licenceUrl} rel="license noopener nofollow" target="_blank">{c.licence}</a>
              : c.licence}
          </span>
        </div>
      ))}
    </div>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import GameCard from '../components/GameCard.astro';
import Hero from '../components/Hero.astro';
import CatBar from '../components/CatBar.astro';
import Deals from '../components/Deals.astro';
import Ad from '../components/Ad.astro';
import Fig from '../components/Fig.astro';
import { getPosts, getGames, byType, byGame, spreadByGame } from '../lib/content';
import { time } from '../lib/format';
import { site, siteCopy, siteHome } from '../site';
import {
  langFromPath, otherLocale, homeHref, sectionHref, pageHref,
  type SectionKey, sectionKeys,
} from '../i18n/config';
import { useT } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
/* Le formulaire poste vers le fournisseur défini dans .env. Sans lui, il ne
   fait rien et le dit plutôt que de faire semblant d'avoir inscrit. */
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION;
const t = useT(lang);
const posts = await getPosts(Astro.locals, lang);
const games = await getGames(Astro.locals, lang);

/* La mosaïque de tête : la sélection maison, la plus récente à défaut.
   Six sujets — un pavé maître, deux de côté, trois en bande.

   Le tour de table est ce qui empêche la Une d'être monographique : cinq
   articles publiés coup sur coup sur le même jeu la remplissaient
   entièrement, et le site avait l'air de ne couvrir que lui. La priorité
   reste la sélection maison, puis la date — le tour de table ne fait que
   décider qui passe avant qui à priorité égale. */
const featured = posts.filter((p) => p.data.featured);
const hero = spreadByGame([...featured, ...posts.filter((p) => !p.data.featured)], 6);
/* Le Fil garde son heure sur chaque entrée, mais pas cinq fois le même jeu :
   c'est la dernière nouvelle de chacun, pas les cinq dernières tout court. */
const wire = spreadByGame(posts, 5);

/* L'ordre des blocs suit la colonne vertébrale du portail : la Une, puis les
   jeux couverts, puis les rubriques — guides d'abord, l'entrée la plus
   cherchée sur un média de jeu en service. Chaque rubrique garde sa maille. */
const order: SectionKey[] = ['guide', 'news', 'review', 'setup'];
const perBlock: Record<SectionKey, number> = { guide: 3, news: 4, review: 3, setup: 3 };
const labels: Record<SectionKey, string> = {
  news: t('nav.news'), review: t('nav.reviews'), guide: t('nav.guides'), setup: t('nav.setup'),
};
/* Chaque rubrique passe par le même tour de table : sans lui, « Guides »
   ouvrait sur deux articles du même jeu à la suite. Une rubrique reste
   classée par date — le tour de table ne décide que des ex æquo. */
const blocks = order
  .map((key) => ({ key, label: labels[key], items: spreadByGame(byType(posts, key), perBlock[key]) }))
  .filter((b) => b.items.length > 0);

const counts: Record<string, number> = {
  ...Object.fromEntries(sectionKeys.map((k) => [k, byType(posts, k).length])),
  games: games.length,
};

/* Les jeux couverts : la grille remonte juste sous la Une — sur un média de
   jeu en service, on navigue par jeu avant de naviguer par rubrique.

   L'accueil n'en montre qu'une rangée pleine. La grille tient six colonnes au
   plus large : la page fait 1360px moins 2×24 de marge, soit 1312, et six
   pistes de 190 séparées par 16 en demandent 1220 quand sept en demanderaient
   1426. Le septième jeu tombait donc seul sur une deuxième rangée et laissait
   cinq emplacements vides — une rangée entière de vide pour une vignette.
   Les jeux au-delà vivent sur « Tous les jeux », dont le lien est juste à
   côté du titre. */
const countFor = (id: string) => byGame(posts, id).length;
const ROW = 6;
/* Le classement décide qui reste et qui passe sur « Tous les jeux ». Les
   abonnés d'abord — c'est la donnée voulue — mais aucune fiche n'en porte
   aujourd'hui, et le tri serait alors sans effet : l'ordre rendu par la base
   déciderait à sa place, et le jeu écarté changerait au gré des lignes. On
   départage donc par la couverture, ce que cette section annonce justement,
   puis par le titre pour que deux jeux à égalité gardent un ordre stable. */
const covered = [...games]
  .sort((a, b) =>
    (b.data.followers ?? 0) - (a.data.followers ?? 0)
    || countFor(b.id) - countFor(a.id)
    || a.data.title.localeCompare(b.data.title))
  .slice(0, ROW);
const hasDeals = games.some((g) => g.data.offers.length > 0);

/* Tendances : les articles des jeux les plus suivis. Le classement vient des
   données du site (`followers`), pas d'un compteur de vues qu'on n'a pas. */
const rank = new Map(games.map((g) => [g.id, g.data.followers ?? 0]));
/* Le classement suivait les abonnés puis la date : les quatre places
   revenaient donc au seul jeu le plus suivi. Le tour de table en fait ce
   qu'un palmarès doit être — le meilleur sujet de chacun, dans l'ordre des
   jeux les plus suivis. */
const trending = spreadByGame(
  [...posts]
    .filter((p) => p.game)
    .sort((a, b) => (rank.get(b.game!.id) ?? 0) - (rank.get(a.game!.id) ?? 0)
      || b.data.date.getTime() - a.data.date.getTime()),
  4,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: siteHome,
  inLanguage: lang,
  description: siteCopy[lang].description,
};
---
<Base title={t('home.title')} jsonLd={jsonLd} alt={homeHref(otherLocale(lang))}>
  <!-- Le Fil : la pulsation. Un média se lit à l'heure. -->
  <div class="fil">
    <div class="fil-in">
      <span class="fil-lbl"><i class="pulse"></i>{t('home.wire')}</span>
      <div class="fil-track">
        {wire.map((p) => (
          <a href={p.href}><time datetime={p.data.date.toISOString()}>{time(p.data.date, lang)}</time>{p.data.title}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="page">
    <!-- Le bandeau de tête est vendu : plus de titre de maison, la place
         entière passe à la réclame. -->
    <div class="masthead">
      <Ad h="90" unit={import.meta.env.PUBLIC_AD_LEADERBOARD} />
      {hasDeals && <a class="btn btn-quiet" href="#offers">{t('home.seeDeals')}</a>}
    </div>

    <!-- Le titre de la page prend la place qu'occupait la barre de rubriques :
         celles-ci vivent maintenant dans le bandeau, en boutons. L'accueil
         gagne le titre de niveau 1 qui lui manquait, sans repousser la réclame d'un pixel.
         Sous 860px le bandeau cache ses liens : la barre reparaît alors, sinon
         « Configs » ne serait plus atteignable depuis le haut de l'accueil. -->
    <h1 class="home-h1">{t('home.h1')}</h1>

    <div class="catbar-m"><CatBar counts={counts} /></div>

    <!-- 1. À la une -->
    <Hero posts={hero} />

    <!-- 2. Les jeux couverts -->
    <section class="cat-sec" id="games">
      <div class="cat-head">
        <h2 class="d3">{t('home.gamesCovered')}</h2>
        <a class="more" href={pageHref(lang, 'games')}>{t('home.allGames')}</a>
      </div>
      <div class="ggrid">
        {covered.map((g) => <GameCard game={g} meta={false} />)}
      </div>
    </section>

    <!-- 3. Les offres : le moteur économique, en pleine largeur -->
    {hasDeals && (
      <section class="cat-sec" id="offers">
        <div class="cat-head">
          <h2 class="d3">{t('home.deals')}</h2>
          <a class="more" href={pageHref(lang, 'games')}>{t('home.allTrackedGames')}</a>
        </div>
        <Deals games={games} />
        <p class="aff-note" style="text-align:center">{t('aff.note')}</p>
      </section>
    )}

    <!-- 4. Le corps du kiosque : les rubriques à gauche, la colonne de
         service à droite (pavé publicitaire + palmarès), collante tant
         qu'elle tient dans la fenêtre. C'est la charpente de la référence. -->
    <div class="split">
      <div>
        {blocks.map((b, i) => (
          <Fragment>
            <section class="cat-sec" id={b.key}>
              <div class="cat-head">
                <h2 class="d3">{b.label}</h2>
                <a class="more" href={sectionHref(lang, b.key)}>{t('home.seeAll')}</a>
              </div>
              {b.key === 'news' ? (
                <div class="pgrid pgrid-lead">
                  {b.items.slice(0, 1).map((p) => <Card post={p} variant="wide" level={3} showLede />)}
                  {b.items.slice(1).map((p) => <Card post={p} variant="sm" level={3} />)}
                </div>
              ) : b.key === 'review' ? (
                <div class="pgrid">
                  {b.items.map((p) => <Card post={p} variant="verdict" level={3} />)}
                </div>
              ) : (
                <div class="pgrid">
                  {b.items.map((p) => <Card post={p} variant="sm" level={3} showLevel showVersion />)}
                </div>
              )}
              <div class="cat-foot">
                <a class="btn btn-quiet" href={sectionHref(lang, b.key)}>{t('home.seeAllOf')(b.label)}</a>
              </div>
            </section>

            {i === 0 && (
              <div style="margin-block:var(--s-6)">
                <Ad h="90" unit={import.meta.env.PUBLIC_AD_LEADERBOARD} />
              </div>
            )}
          </Fragment>
        ))}
      </div>

      <aside class="sticky">
        <Ad h="250" unit={import.meta.env.PUBLIC_AD_SIDEBAR} />
        <div>
          <div class="cat-head">
            <h2 class="d4">{t('home.trending')}</h2>
            <a class="more" href={pageHref(lang, 'games')}>{t('home.gameDatabase')}</a>
          </div>
          <ol class="trend">
            {trending.map((p, i) => (
              <li>
                <span class="trend-n" aria-hidden="true">{i + 1}</span>
                <article class="card card-sm card-xs">
                  <Fig src={p.data.cover} alt="" ratio="1-1" widths={[164]} sizes="82px" />
                  <div class="card-body">
                    <h3><a href={p.href}>{p.data.title}</a></h3>
                    <p class="card-meta"><span>{labels[p.section]}</span></p>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>

    <!-- 5. L'appel : le panneau et le formulaire ne font plus qu'un.
         Il y avait deux appels à la lettre à quatre cents pixels d'écart : le
         premier ne savait que renvoyer au second. Un lecteur convaincu par le
         premier devait donc scroller pour faire ce qu'il venait de décider.
         Le champ remonte ici, et l'ancre #newsletter reste sur ce bloc — c'est
         elle que visent « S'abonner » du bandeau et « Suivre » d'une fiche. -->
    <section class="cat-sec" id="newsletter">
      <div class="promo">
        <div>
          <h2 class="d3">{t('home.promoTitle')}</h2>
          <p>{t('home.promoBody')}</p>
        </div>
        <div class="promo-signup">
          <form class="news-form" action={newsletterAction} method="post" novalidate
                data-newsletter={newsletterAction ? undefined : ''}>
            <label class="sr" for="nl">{t('news.email')}</label>
            <input class="input" id="nl" name="email" type="email" inputmode="email"
                   autocomplete="email" spellcheck="false" autocapitalize="off"
                   placeholder={t('news.placeholder')} required
                   aria-describedby="nl-msg">
            <button class="btn btn-primary btn-lg" type="submit">{t('news.cta')}</button>
          </form>
          <p class="msg" id="nl-msg" role="alert" hidden></p>
          <p class="meta">{t('news.terms')}</p>
        </div>
      </div>
    </section>
  </div>
</Base>

---
import { langFromPath } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { id?: string; }
const { id = 'newsletter' } = Astro.props;
/* Formulaire posté vers le fournisseur défini dans .env (Buttondown, Beehiiv…).
   Sans NEWSLETTER_ACTION, il ne fait rien et le dit. */
const action = import.meta.env.PUBLIC_NEWSLETTER_ACTION;
const t = useT(langFromPath(Astro.url.pathname));
---
<section class="sec" id={id} style="padding-top:0">
  <div class="news-box">
    <div>
      <span class="kicker">{t('news.kicker')}</span>
      <h2 class="d3" style="margin:10px 0 8px">{t('news.title')}</h2>
      <p style="color:var(--tx-2);max-width:56ch">{t('news.body')}</p>
    </div>
    <form class="news-form" action={action} method="post" novalidate
          data-newsletter={action ? undefined : ''}>
      <label class="sr" for="nl">{t('news.email')}</label>
      <input class="input" id="nl" name="email" type="email" inputmode="email"
             autocomplete="email" spellcheck="false" autocapitalize="off"
             placeholder={t('news.placeholder')} required
             aria-describedby="nl-msg">
      <button class="btn btn-primary btn-lg" type="submit">{t('news.cta')}</button>
    </form>
    <p class="msg" id="nl-msg" role="alert" hidden></p>
    <p class="meta">{t('news.terms')}</p>
  </div>
</section>

---
interface Props { id?: string; }
const { id = 'newsletter' } = Astro.props;
/* Formulaire posté vers le fournisseur défini dans .env (Buttondown, Beehiiv…).
   Sans NEWSLETTER_ACTION, il ne fait rien et le dit. */
const action = import.meta.env.PUBLIC_NEWSLETTER_ACTION;
---
<section class="sec" id={id} style="padding-top:0">
  <div class="news-box">
    <div>
      <span class="kicker">Chaque mardi</span>
      <h2 class="d3" style="margin:10px 0 8px">Ce qui compte vraiment cette semaine</h2>
      <p style="color:var(--tx-2);max-width:56ch">
        Une sélection courte : les sorties qui valent le coup, les patchs qui changent un jeu,
        les tests que nous révisons. Pas de liste de liens.
      </p>
    </div>
    <form class="news-form" action={action} method="post" novalidate
          data-newsletter={action ? undefined : ''}>
      <label class="sr" for="nl">Adresse e-mail</label>
      <input class="input" id="nl" name="email" type="email" inputmode="email"
             autocomplete="email" spellcheck="false" autocapitalize="off"
             placeholder="vous@exemple.fr" required
             aria-describedby="nl-msg">
      <button class="btn btn-primary btn-lg" type="submit">Recevoir la lettre</button>
    </form>
    <p class="msg" id="nl-msg" role="alert" hidden></p>
    <p class="meta">Un envoi par semaine. Désabonnement en un clic.</p>
  </div>
</section>

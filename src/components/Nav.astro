---
import Fig from './Fig.astro';
import { site, platforms, genres } from '../site';
import { getGames, getPosts, allTags } from '../lib/content';
import { num, scoreBucket, shortDate } from '../lib/format';
import { slugifyTag } from '../lib/content';
import {
  langFromPath, otherLocales, localeNames, homeHref, sectionHref, pageHref, gameHref, tagHref,
  type Locale,
} from '../i18n/config';
import { useT } from '../i18n/ui';

/* La barre passe la langue courante à tout ce qu'elle rend, et offre le
   basculement vers les autres. `alt` donne l'URL de CETTE page dans une langue
   donnée : seule la page la connaît, elle la fait descendre par le gabarit. */
interface Props { alt?: (l: Locale) => string }
const { alt } = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const others = otherLocales(lang);
const t = useT(lang);

const games = await getGames(Astro.locals, lang);
/* Les jetons du méga-menu sont des liens vers /tag/<slug>/, et cette route ne
   connaît que les étiquettes portées par un article : une plateforme ou un
   genre que personne n'a encore taguée n'a pas de page, et le lien tombait sur
   un 404. Sept d'un coup, dans la barre — donc sur chaque page du site.
   La liste de `site.ts` reste ce qu'on VEUT montrer ; ce filtre ne garde que
   ce qui existe. Le jour où un article porte l'étiquette, le jeton revient
   tout seul. */
const liveTags = new Set(allTags(await getPosts(Astro.locals, lang)).map(([t]) => slugifyTag(t)));
const linkable = (list: string[]) => list.filter((x) => liveTags.has(slugifyTag(x)));
const navPlatforms = linkable(platforms);
const navGenres = linkable(genres[lang]);
/* Le méga-menu n'est pas une liste de liens : c'est un chercheur de jeux. */
const followed = [...games]
  .sort((a, b) => (b.data.followers ?? 0) - (a.data.followers ?? 0))
  .slice(0, 4);
const upcoming = games
  .filter((g) => g.data.releaseDate && g.data.releaseDate > new Date())
  .sort((a, b) => a.data.releaseDate!.getTime() - b.data.releaseDate!.getTime())
  .slice(0, 3);

const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(href);

/* Pas d'entrée « Accueil » : l'accueil n'est pas une rubrique, c'est la page
   qu'on obtient en entrant sur le site. Listée à côté d'Actus et de Tests,
   elle s'allumait comme une section de plus alors qu'elle n'en est pas une —
   et le retour se fait par la marque, qui est là pour ça sur chaque page.
   Le fil d'Ariane garde son « Accueil » : là, c'est une racine, pas un onglet. */
const links = [
  { label: t('nav.news'), href: sectionHref(lang, 'news') },
  { label: t('nav.reviews'), href: sectionHref(lang, 'review') },
  { label: t('nav.guides'), href: sectionHref(lang, 'guide') },
  { label: t('nav.setup'), href: sectionHref(lang, 'setup') },
];
---
<header class="nav">
  <div class="nav-in">
    <a class="mark" href={homeHref(lang)}><i></i>{site.name}</a>

    <nav class="nav-links" aria-label={t('nav.main')}>
      {links.slice(0, 1).map((l) => (
        <a class="nav-link" href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <div>
        <button class="nav-link" id="megaBtn" aria-expanded="false" aria-controls="mega">
          {t('nav.games')} <span class="chev" aria-hidden="true">▼</span>
        </button>
        <div class="mega" id="mega" hidden>
          <div class="mega-grid">
            <div class="mega-col">
              <p class="mega-h">{t('mega.mostFollowed')}</p>
              <div class="mega-list">
                {followed.map((g) => (
                  <a class="mega-item" href={gameHref(lang, g.id)}>
                    <Fig src={g.data.cover} ratio="3-4" class="cover" sizes="34px" />
                    <span><b>{g.data.title}</b><span>{g.data.studio} · {g.data.released}</span></span>
                    <span class="sc" style={g.data.score !== undefined ? `color:var(--sc-${scoreBucket(g.data.score)})` : 'color:var(--tx-3)'}>
                      {g.data.score !== undefined ? num(g.data.score, lang) : t('mega.upcomingSoon')}
                    </span>
                  </a>
                ))}
              </div>
            </div>
            <div class="mega-col">
              {navPlatforms.length > 0 && (
                <Fragment>
                  <p class="mega-h">{t('mega.byPlatform')}</p>
                  <div class="chipbar">
                    {navPlatforms.map((p) => <a class="tag" href={tagHref(lang, slugifyTag(p))}>{p}</a>)}
                  </div>
                </Fragment>
              )}
              {navGenres.length > 0 && (
                <Fragment>
                  <p class="mega-h" style={navPlatforms.length > 0 ? 'margin-top:24px' : undefined}>{t('mega.byGenre')}</p>
                  <div class="chipbar">
                    {navGenres.map((g) => <a class="tag" href={tagHref(lang, slugifyTag(g))}>{g}</a>)}
                  </div>
                </Fragment>
              )}
            </div>
            <div class="mega-col">
              <p class="mega-h">{t('mega.upcoming')}</p>
              <div class="cal">
                {upcoming.map((g) => {
                  const [d, m] = shortDate(g.data.releaseDate!, lang).split(' ');
                  return (
                    <a class="cal-row" href={gameHref(lang, g.id)}>
                      <span class="date">{d}<small>{m}</small></span>
                      <b>{g.data.title}</b>
                      <span class="meta">{g.data.platforms.map((p) => p.name).join(' · ')}</span>
                    </a>
                  );
                })}
              </div>
            </div>
            <div class="mega-foot">
              <span class="meta">{t('mega.gamesTracked')(games.length)}</span>
              <a class="btn btn-sm btn-quiet" href={pageHref(lang, 'games')}>{t('mega.browse')}</a>
            </div>
          </div>
        </div>
      </div>
      {links.slice(1).map((l) => (
        <a class="nav-link" href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <span class="nav-sp"></span>
    <!-- sous 860px le libellé et le raccourci passent en display:none : sans
         aria-label le bouton n'aurait plus aucun nom accessible au doigt -->
    <button class="searchbar" data-search aria-label={t('search.open')}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <span>{t('search.placeholder')}</span><kbd>⌘&nbsp;K</kbd>
    </button>
    <!-- Un seul bouton, celui de la langue courante ; les autres tiennent
         dans le menu qu'il ouvre. Chaque cible porte son nom dans SA langue,
         jamais traduit — c'est ce qu'un lecteur cherche du regard. Sous 560 px
         le sélecteur disparaît du bandeau, déjà plein au doigt ; le pied de
         page porte le même choix, avec les mêmes URL. -->
    <nav class="lang-switch" aria-label={t('nav.language')}>
      <button class="btn btn-sm btn-quiet lang-btn" id="langBtn" aria-expanded="false" aria-controls="langMenu"
              aria-label={t('nav.language') + t('punct.colon') + localeNames[lang]}>
        {lang.toUpperCase()} <span class="chev" aria-hidden="true">▼</span>
      </button>
      <div class="lang-menu" id="langMenu" hidden>
        {others.map((l) => (
          <a href={alt ? alt(l) : homeHref(l)} hreflang={l} lang={l}
             aria-label={useT(l)('nav.language') + useT(l)('punct.colon') + localeNames[l]}>
            <b>{l.toUpperCase()}</b><span>{localeNames[l]}</span>
          </a>
        ))}
      </div>
    </nav>
    <button class="btn btn-ico btn-quiet" id="theme" aria-label={t('theme.toLight')}>◐</button>
    <a class="btn btn-primary btn-sm" href={`${homeHref(lang)}#newsletter`}>{t('nav.subscribe')}</a>
  </div>
</header>

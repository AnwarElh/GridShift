---
import Fig from './Fig.astro';
import type { Post } from '../lib/content';
import { langFromPath } from '../i18n/config';
import { useT } from '../i18n/ui';
import { ago, iso } from '../lib/format';

/* LE JEU DE CARTES — la Une du portail.

   Six sujets posés comme une main de cartes sur une bande de couleur pleine :
   cinq jaquettes en éventail, inclinées, et le sujet du jour à plat par-dessus.
   Une mosaïque range les sujets ; un éventail les DONNE. La différence tient
   à ce qu'un portail vend d'abord : pas un sommaire, une arrivée de nouvelles.

   L'heure relative est l'accessoire principal, pas une mention de bas de
   carte : « il y a 2 heures » posé à côté d'une jaquette dit en trois mots
   ce qu'une date ne dit pas — que le site a bougé depuis la dernière visite.

   Au pouce, l'éventail n'a plus de place : le même conteneur redevient un
   rail qui défile carte par carte. Le script du site le fait tourner tout
   seul — il ne connaît que `data-slider` et `data-dots`, donc la mécanique
   du carrousel ne change pas d'une ligne. */
interface Props { posts: Post[]; }
const { posts } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);

const [lead, ...fan] = posts;
/* Cinq jaquettes au plus : au-delà, l'éventail se referme sur lui-même et
   les cartes du fond ne montrent plus qu'une tranche. */
const cards = fan.slice(0, 5);
---
<section class="deck" aria-label={t('home.headlines')}>
  <div class="deck-stage" data-slider>
    {lead && (
      <article class="dtile dtile-lead">
        {/* la carte de tête ne porte pas sa jaquette en fond : elle est à
            plat, en pleine matière, et c'est ce contraste avec les cinq
            autres qui la désigne comme le sujet du jour. */}
        <Fig src={lead.data.cover} alt="" ratio="16-9"
             widths={[560, 840, 1120]} sizes="(max-width:860px) 92vw, 430px" priority />
        <div class="dtile-body">
          <time class="dtile-ago" datetime={iso(lead.data.date)}>{ago(lead.data.date, lang)}</time>
          <h2><a href={lead.href}>{lead.data.title}</a></h2>
          {lead.data.lede && <p>{lead.data.lede}</p>}
        </div>
      </article>
    )}

    {cards.map((p, i) => (
      <article class={`dtile dtile-fan f${i + 1}`}>
        {/* l'heure vit hors du corps : en éventail elle flotte sur la bande
            à côté de la carte, au pouce elle reprend sa place au-dessus du
            titre. Un seul élément dans les deux cas — donc une seule chose
            à relire pour un lecteur d'écran, et une seule à rafraîchir. */}
        <time class="dtile-ago" datetime={iso(p.data.date)}>{ago(p.data.date, lang)}</time>
        {/* La jaquette est un 16/9 recadré en 3/4 : `object-fit:cover` met
            l'image à l'échelle sur la HAUTEUR, pas sur la largeur. Une carte
            de 225px réclame donc une source de 225 × 4/3 × 16/9 ≈ 533px, et
            le double sur écran dense. `sizes` annonce cette largeur-là, pas
            celle de la boîte : sinon le navigateur prend une variante deux
            fois trop petite et l'agrandit — c'est ce qui rendait l'éventail
            flou pendant que la carte de tête, elle, restait nette.
            Au pouce la carte repasse en 16/9 (voir la feuille de style) :
            92vw y est la largeur vraie, sans correction. */}
        <Fig src={p.data.cover} alt="" ratio="3-4"
             widths={[480, 720, 1080]} sizes="(max-width:860px) 92vw, 533px" />
        {/* le titre ne s'affiche qu'au pouce, où la carte devient une vraie
            diapositive ; en éventail il ne tiendrait pas dans la tranche
            visible, et une carte muette y est plus honnête qu'un titre coupé. */}
        <div class="dtile-body">
          <h3><a href={p.href}>{p.data.title}</a></h3>
        </div>
        <a class="dtile-hit" href={p.href}><span class="sr">{p.data.title}</span></a>
      </article>
    ))}
  </div>

  {/* Les commandes n'existent qu'au pouce : en éventail les six cartes sont
      posées d'un coup, il n'y a rien à faire défiler ni à mettre en pause. */}
  {posts.length > 1 && (
    <div class="hero-dots" data-dots hidden>
      {posts.map((_, i) => (
        <button type="button" data-go={i} aria-label={t('home.goToStory')(i + 1)}
                aria-current={i === 0 ? 'true' : 'false'}></button>
      ))}
      {/* WCAG 2.2.2 : ce qui bouge tout seul plus de cinq secondes doit
          pouvoir être arrêté. Les points ne sont pas une pause. */}
      <button type="button" class="hero-pause" data-pause
              data-label-pause={t('home.pauseStories')} data-label-play={t('home.playStories')}
              aria-label={t('home.pauseStories')}>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <rect class="i-pause" x="4" y="3" width="3" height="10" rx="1"></rect>
          <rect class="i-pause" x="9" y="3" width="3" height="10" rx="1"></rect>
          <path class="i-play" d="M5 3.5v9l8-4.5z"></path>
        </svg>
      </button>
    </div>
  )}
</section>

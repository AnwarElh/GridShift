---
import Fig from './Fig.astro';
import Chips from './Chips.astro';
import PostMeta from './PostMeta.astro';
import Version from './Version.astro';
import Score from './Score.astro';
import type { Post } from '../lib/content';

interface Props {
  post: Post;
  variant?: 'lead' | 'wide' | 'md' | 'sm' | 'xs' | 'review' | 'verdict';
  ratio?: '16-9' | '3-2' | '4-3' | '1-1' | '3-4';
  showLede?: boolean;
  showVersion?: boolean;
  /* le niveau d'un guide : Débutant, Avancé, Soluce — c'est ce qu'on cherche en premier */
  showLevel?: boolean;
  /* la ligne de service est la norme ; `meta="none"` la retire */
  meta?: 'service' | 'none';
  /* niveau de titre : le contexte de la page décide, pas la carte */
  level?: 1 | 2 | 3;
}
const {
  post, variant = 'md', ratio, showLede = false, showVersion = false,
  showLevel = false, meta = 'service', level,
} = Astro.props;
const { data } = post;
const H = `h${level ?? (variant === 'lead' ? 1 : 3)}` as 'h1' | 'h2' | 'h3';
const r = ratio ?? (
  variant === 'lead' || variant === 'verdict' ? '16-9'
  : variant === 'xs' ? '1-1'
  : '3-2'
);
/* la note est la raison d'être d'une carte de test : elle se pose sur la
   vignette à sa vraie taille, pas en pastille de 11 px dans un coin */
const withNote = variant === 'verdict' && data.score !== undefined;

/* `sizes` annonce la largeur de l'EMPLACEMENT, et sans lui `Fig` retombe sur
   `100vw` : le navigateur croit alors la vignette large comme la fenêtre et
   prend la plus grande variante — 1920 px pour une carte de 96. Chaque valeur
   suit la feuille de style : `.pgrid` tient trois colonnes dans 1312 px, deux
   sous 1024 et une sous 560 ; `.card-xs` a une largeur fixe.
   La carte étroite du rail est un peu plus petite que la case de grille : on
   l'annonce à la taille de la case, parce qu'une surestimation coûte des
   octets là où une sous-estimation coûte de la netteté. */
const SIZES: Record<NonNullable<Props['variant']>, string> = {
  wide:    '(max-width:860px) 100vw, 620px',
  lead:    '(max-width:560px) 92vw, (max-width:1024px) 47vw, 420px',
  md:      '(max-width:560px) 92vw, (max-width:1024px) 47vw, 420px',
  sm:      '(max-width:560px) 92vw, (max-width:1024px) 47vw, 420px',
  verdict: '(max-width:560px) 92vw, (max-width:1024px) 47vw, 420px',
  review:  '(max-width:560px) 92vw, (max-width:1024px) 47vw, 420px',
  xs:      '(max-width:560px) 82px, 96px',
};
---
{variant === 'review' ? (
  <a class="card card-review" href={post.href}>
    <Fig src={data.cover} alt={data.title} ratio={r} sizes={SIZES[variant]} />
    {data.score !== undefined && (
      <span class="plate"><span class="plate-in"><Score score={data.score} size="sm" /></span></span>
    )}
  </a>
) : (
  <article
    class:list={[
      'card',
      variant === 'lead' && 'card-lead',
      variant === 'wide' && 'card-wide',
      variant === 'verdict' && 'card-verdict',
      (variant === 'sm' || variant === 'xs') && 'card-sm',
      variant === 'xs' && 'card-xs',
    ]}>
    <Fig src={data.cover} alt="" ratio={r}
         widths={variant === 'wide' ? [640, 960, 1280] : undefined}
         sizes={SIZES[variant]} />
    {variant !== 'xs' && <Chips post={post} max={variant === 'lead' || variant === 'wide' ? 3 : 2} showScore={!withNote} />}
    {withNote && <span class="card-note"><Score score={data.score!} /></span>}
    <div class="card-body">
      {variant === 'xs' && <Chips post={post} max={1} />}
      {meta !== 'none' && <PostMeta date={data.date} minutes={post.minutes} />}
      <H><a href={post.href}>{data.title}</a></H>
      {showLede && data.lede && <p>{data.lede}</p>}
      {(showVersion || (showLevel && data.level)) && (
        <span class="card-tags">
          {showLevel && data.level && <span class="badge b-out">{data.level}</span>}
          {showVersion && <Version version={data.testedOn} stale={data.stale} />}
        </span>
      )}
    </div>
  </article>
)}

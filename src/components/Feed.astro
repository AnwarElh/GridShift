---
import Fig from './Fig.astro';
import Chips from './Chips.astro';
import { feedStamp } from '../lib/format';
import { slugifyTag, type Post } from '../lib/articles';
import { useT } from '../i18n/ui';
interface Props { posts: Post[]; side?: 'game' | 'version' | 'type'; }
const { posts, side = 'game' } = Astro.props;
const label = (p: Post) => {
  const t = useT(p.lang);
  return { news: t('nav.news'), review: t('nav.reviews'), guide: t('nav.guides'), setup: t('nav.setup') }[p.section];
};
const aside = (p: Post) =>
  side === 'version' ? (p.data.testedOn ?? '—') : side === 'type' ? label(p) : (p.game?.data.title ?? label(p));
---
<div class="feed">
  {posts.map((p) => (
    <article class="feed-item" data-live={p.data.live ? '' : undefined}
             data-tags={[...p.data.tags, p.data.level, p.game?.data.title].filter(Boolean).map((t) => slugifyTag(t as string)).join('|')}>
      <Fig src={p.data.cover} alt="" ratio="16-9" widths={[148, 296]} sizes="148px" />
      <div>
        <div class="feed-head">
          <Chips post={p} max={2} class="chips-inline" />
          <time class="feed-time" datetime={p.data.date.toISOString()}>{feedStamp(p.data.date, p.lang)}</time>
          <span class="feed-time">{p.minutes} {useT(p.lang)('card.min')}</span>
        </div>
        <h3><a href={p.href}>{p.data.title}</a></h3>
      </div>
      <span class="side">{aside(p)}</span>
    </article>
  ))}
</div>

---
import { langFromPath, homeHref, sectionHref, pageHref } from '../i18n/config';
import { useT } from '../i18n/ui';
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const path = Astro.url.pathname;
const on = (href: string) => ((href === homeHref(lang) ? path === href : path.startsWith(href)) ? 'page' : undefined);
const home = homeHref(lang);
---
<nav class="tabbar" aria-label={t('nav.mobile')}>
  <ul>
    <li><a href={home} aria-current={on(home)}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>{t('nav.home')}</a></li>
    <li><a href={sectionHref(lang, 'news')} aria-current={on(sectionHref(lang, 'news'))}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h10"/></svg>{t('nav.news')}</a></li>
    <li><a href={pageHref(lang, 'games')} aria-current={on(pageHref(lang, 'games'))}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 4v16"/></svg>{t('nav.games')}</a></li>
    <li><button type="button" data-search><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>{t('search.label')}</button></li>
    <li><a href={sectionHref(lang, 'review')} aria-current={on(sectionHref(lang, 'review'))}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12v17l-6-4-6 4z"/></svg>{t('nav.reviews')}</a></li>
    <li><a href={sectionHref(lang, 'guide')} aria-current={on(sectionHref(lang, 'guide'))}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2z"/><path d="M9 7h6M9 11h6"/></svg>{t('nav.guides')}</a></li>
  </ul>
</nav>

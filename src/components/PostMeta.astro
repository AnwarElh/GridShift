---
/* Ligne de service d'une vignette : date + temps de lecture.
   Les deux repères que le lecteur scanne avant de cliquer. */
import { longDate } from '../lib/format';
interface Props { date: Date; minutes?: number; class?: string; }
const { date, minutes, class: cls = '' } = Astro.props;
---
<p class:list={['card-meta', cls]}>
  <span>
    <i aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></i>
    <time datetime={date.toISOString()}>{longDate(date)}</time>
  </span>
  {minutes && (
    <span>
      <i aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></i>
      {minutes} min
    </span>
  )}
</p>

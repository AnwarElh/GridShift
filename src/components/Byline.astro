---
import Version from './Version.astro';
import { longDate } from '../lib/format';
import type { Post } from '../lib/content';
import { authorHref } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { post: Post; compact?: boolean; }
const { post, compact = false } = Astro.props;
const { data } = post;
const a = post.author.data;
const lang = post.lang;
const t = useT(lang);
---
<div class="byline" style={compact ? 'border-bottom:0' : undefined}>
  <span class="avatar av-sm" aria-hidden="true">{a.initials}</span>
  <span class="who">
    <b><a href={authorHref(lang, post.author.id)}>{a.name}</a></b>
    <span>{a.role}</span>
  </span>
  <span class="sp"></span>
  <Version version={data.testedOn} stale={data.stale} prefix={t('review.testedOn')} />
  <span class="meta">
    <b>{t('review.readTime')(post.minutes)}</b>
    <span class="dot">·</span>
    <time datetime={(data.updated ?? data.date).toISOString()}>
      {data.updated ? t('review.updatedOn')(longDate(data.updated, lang)) : longDate(data.date, lang)}
    </time>
  </span>
</div>

---
import { site, footerLinks, socials } from '../site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot-in">
    <div class="foot-brand">
      <a class="mark" href="/"><i></i>{site.name}</a>
      <p>{site.description}</p>
      <div class="socials">
        {socials.map((s) => (
          <a href={s.href} rel="noopener" aria-label={s.name} title={s.name}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} /></svg>
          </a>
        ))}
      </div>
    </div>
    {footerLinks.map((col) => (
      <div>
        <h2>{col.title}</h2>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}
  </div>
  <div class="foot-bar"><div>
    <span>© {year} {site.name} — {site.tagline}</span>
    <span>
      <b>Liens affiliés :</b> certaines offres nous rapportent une commission.
      Elle ne change ni votre prix, ni nos notes.
    </span>
  </div></div>
</footer>

---
import { site, siteCopy, footerLinks, socials } from '../site';
import { langFromPath, homeHref, feedHref, locales, localeNames, type Locale } from '../i18n/config';
import { useT } from '../i18n/ui';

/* Le même `alt` que le bandeau : sous 560 px le sélecteur du haut disparaît,
   et un pied de page qui n'aurait su renvoyer que vers l'accueil aurait fait
   perdre sa page au lecteur au moment précis où il change de langue. */
interface Props { alt?: (l: Locale) => string }
const { alt } = Astro.props;

const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const year = new Date().getFullYear();
const cols = footerLinks(lang);
---
<footer class="foot">
  <div class="foot-in">
    <div class="foot-brand">
      <a class="mark" href={homeHref(lang)}><i></i>{site.name}</a>
      <p>{siteCopy[lang].description}</p>
      <div class="socials">
        {socials.map((s) => (
          <a href={s.name === 'RSS' ? feedHref(lang) : s.href} rel="noopener" aria-label={s.name} title={s.name}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} /></svg>
          </a>
        ))}
      </div>
      <nav class="foot-lang" aria-label={t('nav.language')}>
        {locales.map((l) => (
          l === lang
            ? <span aria-current="true" lang={l}>{localeNames[l]}</span>
            : <a href={alt ? alt(l) : homeHref(l)} hreflang={l} lang={l}>{localeNames[l]}</a>
        ))}
      </nav>
    </div>
    {cols.map((col) => (
      <div>
        <h2>{col.title}</h2>
        <ul>{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}
  </div>
  <div class="foot-bar"><div>
    <span>© {year} {site.name} — {siteCopy[lang].tagline}</span>
    <span><b>{t('foot.affiliateNote')}</b> {t('foot.affiliateBody')}</span>
  </div></div>
</footer>

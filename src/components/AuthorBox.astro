---
import type { Author } from '../lib/content';
import { langFromPath, authorHref } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { author: Author; count?: number; style?: string; }
const { author, count, style } = Astro.props;
const a = author.data;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
---
<div class="author" style={style}>
  <span class="avatar">{a.initials}</span>
  <div>
    <b style="font-size:var(--ui-lg)">{a.name}</b>
    <p class="role">{a.role}{a.since && ` · ${t('author.since')(a.since)}`}</p>
    <p class="bio">{a.bio}</p>
    <div class="creds">
      {count !== undefined && <span class="tag">{t('author.published')(count)}</span>}
      {a.creds.map((c) => <span class="tag">{c}</span>)}
      <a class="tag" href={authorHref(lang, author.id)}>{t('game.allArticles')}</a>
    </div>
  </div>
</div>

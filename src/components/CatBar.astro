---
/* La barre de rubriques : l'axe de navigation du portail. */
import { langFromPath, sectionHref, pageHref, sectionKeys } from '../i18n/config';
import { useT } from '../i18n/ui';
interface Props { counts?: Record<string, number>; }
const { counts = {} } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const path = Astro.url.pathname;

/* Pas d'entrée « Tout » : l'accueil n'est pas une rubrique, c'est la page
   qu'on obtient en entrant sur le site. La lister à côté d'Actus et de Tests
   en faisait une section de plus, et l'accueil a déjà « Home » dans le
   bandeau. La barre ne porte donc que de vraies rubriques. */
const labels = { news: t('nav.news'), review: t('nav.reviews'), guide: t('nav.guides'), setup: t('nav.setup') };
const items = [
  ...sectionKeys.map((k) => ({ label: labels[k], href: sectionHref(lang, k), n: counts[k] })),
  { label: t('nav.games'), href: pageHref(lang, 'games'), n: counts.games },
];
const on = (href: string) => !href.includes('#') && path.startsWith(href);
---
<nav class="catbar" aria-label={t('nav.sections')}>
  {items.map((i) => (
    <a href={i.href} aria-current={on(i.href) ? 'page' : undefined}>
      {i.label}{i.n !== undefined && <span class="n">{i.n}</span>}
    </a>
  ))}
</nav>

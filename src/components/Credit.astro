---
import type { Media } from '../lib/content';
/* Attribution d'un visuel. Le crédit ne se cherche plus dans une table du code :
   il voyage avec le média, depuis D1. Un visuel sans ayant droit nommé ne peut
   pas entrer dans la base — la contrainte est en amont, pas ici. */
interface Props { img?: Media; class?: string; }
const { img, class: cls = '' } = Astro.props;
const c = img?.credit;
---
{c && (
  <span class:list={['credit', cls]}>
    <a href={c.source} rel="noopener nofollow" target="_blank">{c.artist}</a>
    {c.licenceUrl
      ? <> · <a href={c.licenceUrl} rel="license noopener nofollow" target="_blank">{c.licence}</a></>
      : <> · {c.licence}</>}
  </span>
)}

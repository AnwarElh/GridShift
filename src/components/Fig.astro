---
import { Image } from 'astro:assets';
/* Figure du système : image réelle si elle existe, plaque vide sinon. */
export interface Props {
  src?: ImageMetadata;
  alt?: string;
  ratio?: '16-9' | '3-2' | '4-3' | '1-1' | '3-4' | '21-9';
  class?: string;
  style?: string;
  as?: 'span' | 'div' | 'figure';
  widths?: number[];
  sizes?: string;
  /* image d'ouverture : chargée tout de suite, jamais lazy */
  priority?: boolean;
}
const { src, alt = '', ratio = '16-9', class: cls = '', style, as: Tag = 'span', widths, sizes, priority = false } = Astro.props;
---
<Tag class:list={['fig', `r-${ratio}`, cls]} style={style}>
  {src
    ? <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
    : <span class="ph" aria-hidden="true"></span>}
</Tag>

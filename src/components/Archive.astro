---
import Crumbs from '../components/Crumbs.astro';
import Card from '../components/Card.astro';
import Pager from '../components/Pager.astro';
import Ad from '../components/Ad.astro';
import Newsletter from '../components/Newsletter.astro';
import { slugifyTag, type Paged, type Post } from '../lib/articles';
import { langFromPath } from '../i18n/config';
import { useT } from '../i18n/ui';

/* Une seule page d'archive pour les rubriques, les tags et les auteurs. */
interface Props {
  title: string;
  lede?: string;
  page: Paged<Post>;
  filters?: string[];
  trail?: { label: string; href?: string }[];
  noun?: string;
  showVersion?: boolean;
}
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const { title, lede, page, filters = [], trail = [], noun = 'article', showVersion = false } = Astro.props;
---
<div class="page" style="padding-top:40px">
  <Crumbs trail={[...trail, { label: title }]} />
  <h1 class="d2" style="margin:12px 0 8px">{title}</h1>
  {lede && <p style="color:var(--tx-2);max-width:56ch;margin-bottom:24px">{lede}</p>}

  {filters.length > 0 && (
    <div class="filters" style="margin-top:24px">
      <div class="chipbar">
        {filters.map((f) => <button class="tag" aria-pressed="false" data-filter={slugifyTag(f)}>{f}</button>)}
      </div>
      <span class="grow"></span>
      <span class="res-count"><b data-count>{page.items.length}</b> {t('archive.onThisPage')(page.items.length, noun)}</span>
    </div>
  )}

  <div class="pgrid" style="margin-top:24px" data-filterable>
    {page.items.map((p) => (
      <div data-tags={[...p.data.tags, p.data.level, p.game?.data.title].filter(Boolean).map((t) => slugifyTag(t as string)).join('|')}>
        <Card post={p} ratio="16-9" showVersion={showVersion} level={2} />
      </div>
    ))}
  </div>

  {page.items.length === 0 && (
    <div class="empty" style="margin-top:32px">
      <span class="glyph" aria-hidden="true">∅</span>
      <h2>{t('archive.emptyTitle')}</h2>
      <p>{t('archive.emptySection')(noun)}</p>
    </div>
  )}

  <!-- filtrage côté client jusqu'à zéro : une grille vide n'explique rien -->
  <div class="empty" id="noResults" style="margin-top:32px" hidden>
    <span class="glyph" aria-hidden="true">∅</span>
    <h2>{t('archive.noneWithFilters')(noun)}</h2>
    <p>{t('archive.emptyBody')}</p>
    <div class="btn-row" style="margin-top:8px">
      <button class="btn btn-quiet" data-clear-filters>{t('archive.clearFilters')}</button>
    </div>
  </div>

  <Pager page={page} />

  <div style="margin-block:var(--s-8)"><Ad h="90" unit={import.meta.env.PUBLIC_AD_LEADERBOARD} /></div>
  <Newsletter id="newsletter" />
</div>

---
/* Bandeau de consentement. Refuser coûte exactement un clic, comme accepter :
   un « refuser » caché derrière un sous-menu n'est pas un consentement libre.
   Tant que rien n'a été choisi, aucun script de régie n'est chargé — c'est
   `site.js` qui l'injecte, et seulement après acceptation. */
import { langFromPath, pageHref } from '../i18n/config';
import { useT } from '../i18n/ui';
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const adsense = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
<div class="consent" id="consent" data-adsense={adsense} hidden
     data-reset-title={t('consent.resetDone')} data-reset-body={t('consent.resetBody')}>
  <div class="consent-in">
    <p>
      <b>{t('consent.title')}</b>
      {t('consent.body')} <a href={pageHref(lang, 'cookies')}>{t('consent.more')}</a>.
    </p>
    <div class="btn-row">
      <button class="btn btn-quiet" type="button" data-consent="no">{t('consent.refuse')}</button>
      <button class="btn btn-primary" type="button" data-consent="yes">{t('consent.accept')}</button>
    </div>
  </div>
</div>

---
import Kicker from './Kicker.astro';
import type { Game } from '../lib/articles';

/* Bloc « où acheter » — le moteur économique du site.
   Étiqueté, daté, jamais déguisé : la mention d'affiliation fait partie
   du bloc, pas d'une page de mentions légales que personne n'ouvre. */
interface Props { game: Game; title?: string; class?: string; id?: string; }
const { game, title = 'Où acheter', class: cls = '', id } = Astro.props;
const d = game.data;
---
{d.offers.length > 0 && (
  <div class:list={['card-framed', cls]} id={id}>
    <Kicker plain tone="mute">{title}</Kicker>
    <div class="offers" style="margin-top:12px">
      {d.offers.map((o) => (
        <a class="offer" data-tone={o.tone} href={o.url} rel="sponsored nofollow noopener" target="_blank">
          <span class="shop">{o.shop}</span>
          <span class="amount">{o.price}</span>
          <span class:list={['btn', 'btn-sm', o.tone === 'brass' ? 'btn-primary' : 'btn-quiet']}>Voir l'offre</span>
        </a>
      ))}
    </div>
    <p class="aff-note">
      {d.pricesCheckedOn && `Prix relevés le ${d.pricesCheckedOn}. `}
      Liens affiliés : nous pouvons toucher une commission, sans effet sur votre prix ni sur notre note.
    </p>
  </div>
)}

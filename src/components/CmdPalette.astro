---
/* Recherche : entités d'abord, articles ensuite.
   L'index est un fichier statique par langue — pas de serveur, pas de dépendance. */
import { langFromPath, searchIndexHref } from '../i18n/config';
import { useT } from '../i18n/ui';
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
---
<dialog class="cmd" id="cmd" aria-label={t('search.label')} data-index={searchIndexHref(lang)}
        data-msg-min={t('search.minChars')}
        data-msg-empty-title={t('search.emptyTitle')} data-msg-empty-body={t('search.emptyBody')}
        data-msg-broken-title={t('search.brokenTitle')} data-msg-broken-body={t('search.brokenBody')}
        data-grp-game={t('search.groupGames')} data-grp-news={t('search.groupNews')}
        data-grp-review={t('search.groupReviews')} data-grp-guide={t('search.groupGuides')}
        data-grp-setup={t('search.groupSetup')}>
  <div class="cmd-top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--tx-3)" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" id="cmdInput" placeholder={t('search.placeholder')} autocomplete="off" aria-label={t('search.label')}>
    <button class="btn btn-sm btn-ghost" id="cmdClose">{t('search.esc')}</button>
  </div>
  <div class="cmd-res" id="cmdRes" role="listbox" aria-label={t('search.results')}></div>
  <div class="cmd-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> {t('search.navigate')}</span><span><kbd>↵</kbd> {t('search.select')}</span><span><kbd>esc</kbd> {t('search.close')}</span>
  </div>
</dialog>

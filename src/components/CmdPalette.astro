---
/* Recherche : entités d'abord, articles ensuite.
   L'index est un fichier statique — pas de serveur, pas de dépendance. */
---
<dialog class="cmd" id="cmd" aria-label="Recherche">
  <div class="cmd-top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--tx-3)" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input type="search" id="cmdInput" placeholder="Chercher un jeu, un test, un guide…" autocomplete="off" aria-label="Rechercher">
    <button class="btn btn-sm btn-ghost" id="cmdClose">Échap</button>
  </div>
  <div class="cmd-res" id="cmdRes" role="listbox" aria-label="Résultats"></div>
  <div class="cmd-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> naviguer</span><span><kbd>↵</kbd> ouvrir</span><span><kbd>esc</kbd> fermer</span>
  </div>
</dialog>

---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import GameCard from '../../components/GameCard.astro';
import Ad from '../../components/Ad.astro';
import Newsletter from '../../components/Newsletter.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getCollection } from 'astro:content';
import { getPosts, byGame } from '../../lib/articles';
import { shortDate } from '../../lib/format';

const posts = await getPosts();
const games = await getCollection('games');
const count = (id: string) => byGame(posts, id).length;
const out = games.filter((g) => !g.data.releaseDate || g.data.releaseDate <= new Date())
  .sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0));
const soon = games.filter((g) => g.data.releaseDate && g.data.releaseDate > new Date())
  .sort((a, b) => a.data.releaseDate!.getTime() - b.data.releaseDate!.getTime());
---
<Base title="Base de jeux" description="Tous les jeux que nous suivons, avec leur note, leur version testée et notre couverture complète.">
  <div class="page" style="padding-top:40px">
    <Crumbs trail={[{ label: 'Jeux' }]} />
    <h1 class="d2" style="margin:12px 0 8px">Base de jeux</h1>
    <p style="color:var(--tx-2);max-width:56ch">
      {games.length} jeux suivis. Chaque fiche regroupe notre note, la version testée et tous nos articles sur le jeu.
    </p>

    {soon.length > 0 && (
      <section class="sec">
        <SectionHead title="Prochaines sorties" sub="Ce que nous couvrirons" />
        <div class="cal">
          {soon.map((g) => {
            const [d, m] = shortDate(g.data.releaseDate!).split(' ');
            return (
              <a class="cal-row" href={`/jeux/${g.id}/`}>
                <span class="date">{d}<small>{m}</small></span>
                <b>{g.data.title}</b>
                <span class="meta">{g.data.platforms.map((p) => p.name).join(' · ')}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="sec" style="padding-top:0">
      <SectionHead title="Tous les jeux" sub="Classés par note" />
      <div class="pgrid">
        {out.map((g) => <GameCard game={g} count={count(g.id)} />)}
      </div>
    </section>

    <div style="margin-block:var(--s-7)"><Ad h="90" unit={import.meta.env.PUBLIC_AD_LEADERBOARD} /></div>
    <Newsletter id="lettre" />
  </div>
</Base>

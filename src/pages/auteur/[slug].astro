---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import Card from '../../components/Card.astro';
import SectionHead from '../../components/SectionHead.astro';
import Ad from '../../components/Ad.astro';
import { getPosts, type Author, type Post } from '../../lib/articles';
import { site } from '../../site';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  const posts = await getPosts();
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author, posts: posts.filter((p) => p.author.id === author.id) },
  }));
}

const { author, posts } = Astro.props as { author: Author; posts: Post[] };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.data.name,
  jobTitle: author.data.role,
  description: author.data.bio,
  url: new URL(`/auteur/${author.id}/`, site.url).href,
  worksFor: { '@type': 'Organization', name: site.name },
};
---
<Base title={author.data.name} description={author.data.bio} jsonLd={jsonLd}>
  <div class="page" style="padding-top:40px">
    <Crumbs trail={[{ label: 'La rédaction', href: '/a-propos/' }, { label: author.data.name }]} />
    <h1 class="d2" style="margin:12px 0 24px">{author.data.name}</h1>
    <AuthorBox author={author} count={posts.length} />

    <section class="sec">
      <SectionHead title="Ses articles" sub={`${posts.length} publication${posts.length > 1 ? 's' : ''}`} />
      <div class="pgrid">
        {posts.map((p) => <Card post={p} variant="sm" />)}
      </div>
    </section>

    <div style="margin-block:var(--s-7)"><Ad h="90" unit={import.meta.env.PUBLIC_AD_LEADERBOARD} /></div>
  </div>
</Base>

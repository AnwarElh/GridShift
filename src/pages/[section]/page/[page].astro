---
import Section from '../../../views/Section.astro';
import { sectionFromSlug } from '../../../i18n/config';

const section = sectionFromSlug('en', Astro.params.section!);
const page = Number(Astro.params.page);
/* La page 1 vit sur /<rubrique>/ : la servir ici aussi dupliquerait l'adresse
   d'un même contenu, ce que les moteurs comptent comme deux pages. */
if (!section || !Number.isInteger(page) || page < 2) return Astro.rewrite('/404');
---
<Section section={section} pageNum={page} />

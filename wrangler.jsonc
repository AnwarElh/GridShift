/**
 * Autnic sur Cloudflare — les quatre liaisons de l'architecture cible.
 *
 *   D1        la source de vérité : articles, rubriques, auteurs, méta SEO
 *   R2        les médias : images et fichiers, sans frais d'egress
 *   KV        le cache : servir une page de base de données aussi vite que du statique
 *   ASSETS    les fichiers statiques du build Astro (polices, favicon, robots)
 *
 * Les identifiants sont vides tant que les ressources ne sont pas créées.
 * `npm run cf:provision` les crée et affiche les identifiants à recopier ici :
 * wrangler ne réécrit pas ce fichier lui-même, et un identifiant inventé
 * échoue au déploiement plutôt qu'au premier appel.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autnic",
  /* L'identifiant de compte n'est pas un secret — il est dans l'URL du tableau
     de bord — et l'écrire ici évite d'avoir à le confier à la CI : un jeton
     d'API suffit alors à déployer. C'est aussi ce qui lève l'ambiguïté le jour
     où le compte n'est plus le seul auquel le jeton donne accès. */
  "account_id": "1446750f7b7085675a3c4fc0be35cf36",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  /* La zone autnic.com est passée sur le compte Cloudflare : le worker peut
     donc porter le domaine lui-même. `custom_domain` demande à Cloudflare de
     poser l'enregistrement DNS et le certificat — d'où le refus tant que la
     zone était ailleurs.

     L'apex seul, sans www : deux routes serviraient les mêmes pages sous deux
     adresses, alors que les canonical et les hreflang de Base.astro n'en
     nomment qu'une. www est une Redirect Rule vers l'apex, côté tableau de
     bord — un 301, pas un second site. */
  "routes": [{ "pattern": "autnic.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autnic-content",
      "database_id": "8940f350-c40c-464e-a500-9e98c1d371c3",
      "migrations_dir": "db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "autnic-media"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "e6e0fc7d3cc44774814547209f4f430e"
    },
    /* Astro tient ses sessions dans KV et attend ce nom de liaison, pas un
       autre : l'adapter Cloudflare code « SESSION » en dur. Espace distinct de
       CACHE — une session n'a ni la durée de vie ni le sort d'une entrée de
       cache, qu'on purge sans prévenir. */
    {
      "binding": "SESSION",
      "id": "2f54bd9891064c96bed2acd3d97cc83e"
    }
  ],

  "vars": {
    /* Le préfixe public des médias R2. Le worker les sert lui-même, par
       src/pages/media/[...key].ts : ça marche partout, y compris hors zone
       Cloudflare, au prix d'un réveil du worker par image — et c'est ce prix
       qui a fini par décider : une page d'accueil référence 34 images, donc
       35 requêtes worker au lieu d'une, soit ~92 % du budget du plan gratuit
       dépensé à recopier des octets de R2 vers le lecteur.

       Le bucket porte maintenant son propre domaine (R2 → autnic-media →
       Custom Domains). Le fichier part de R2 sans réveiller personne et sans
       frais d'egress ; src/pages/media/[...key].ts a été supprimé avec le
       dernier lecteur de /media/. */
    "MEDIA_BASE_URL": "https://media.autnic.com",
    /* Durée de vie d'une page en cache, en secondes.
       Une heure paraissait juste pour un média de jeu, mais c'est le plan
       gratuit qui décide : chaque expiration coûte une écriture KV, et
       126 pages qui expirent toutes les heures font 3 024 écritures par jour
       pour un quota de 1 000. À vingt-quatre heures, le plafond tombe à 126.
       La fraîcheur ne souffre pas pour autant : BUILD_ID entre dans la clé de
       cache (src/lib/cache.ts), donc un `wrangler deploy` invalide les deux
       étages partout dans le monde, tout de suite. C'est publier DANS D1 sans
       redéployer qui attend — jusqu'à un jour. */
    "CACHE_TTL": "86400"
  }
}
